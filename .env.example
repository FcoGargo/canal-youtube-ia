# Copia este archivo a .env y llénalo. .env NO se sube a GitHub (está en .gitignore).
CANAL_NOMBRE=
# El ID del canal (empieza con UC...). Lo imprime: python subida/subir_youtube.py --login
CANAL_ID=
# Idioma de la voz del canal (en, es, pt...)
IDIOMA=en
# Categoría de YouTube: 27 Educación, 28 Ciencia y tecnología, 23 Comedia, 24 Entretenimiento, 22 Gente y blogs
CATEGORIA=27
# Python del entorno virtual donde instalaste chatterbox (deja vacío para usar "python")
PYTHON=
# Navegador para el render: msedge (Windows), chrome (Mac/Linux con Chrome instalado)
NAVEGADOR=msedge
# Carpeta del modelo Parakeet de sherpa-onnx (vacío = ~/.cache/parakeet/)
PARAKEET_DIR=
